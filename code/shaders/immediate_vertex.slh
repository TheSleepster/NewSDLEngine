#ifndef IMMEDIATE_VERTEX_SLH
#define IMMEDIATE_VERTEX_SLH

#ifdef __cplusplus
#include <c_math.h>

typedef vec2_t float2;
typedef vec3_t float3;
typedef vec4_t float4;

typedef mat2_t float2x2;
typedef mat3_t float3x3;
typedef mat4_t float4x4;
#endif // __cplusplus

struct immediate_vertex_t
{
    float4 vPosition;
    float4 vColor;
    float2 vTexCoords0;
    float2 vPadding;
};

struct vertex_shader_out
{
};

#endif IMMEDIATE_VERTEX_SLH // immediate_vertex.slh
