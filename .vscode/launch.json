            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/test_manager",
            "cwd": "${workspaceFolder}/code",
            "args": [],
            "stopOnEntry": false,
            "terminal": "integrated",
        },
    ],
    "compounds": [
        {
            "name": "Host + Client",
            "configurations": ["game_debug (host)", "game_debug (client)"]
        },
        {
            "name": "All Tests",
            "configurations": [
            ]
        }
    ]
}
