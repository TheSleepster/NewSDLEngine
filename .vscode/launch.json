{
    // Debug configurations for Linux (CodeLLDB)
    "version": "0.2.0",
    "configurations": [
        {
            "name": "game_debug (host)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/game_debug",
            "args": ["--host", "7777"],
            "cwd": "${workspaceFolder}/run_tree/res",
            "stopOnEntry": false,
            "terminal": "integrated"
        },
        {
            "name": "game_debug (client)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/game_debug",
            "args": ["--client", "127.0.0.1", "7777"],
            "cwd": "${workspaceFolder}/run_tree/res",
            "stopOnEntry": false,
            "terminal": "integrated"
        },
        {
            "name": "wad_file_packer",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/wad_asset_file_packer",
            "args": [],
            "cwd": "${workspaceFolder}/run_tree/res",
            "stopOnEntry": false,
            "terminal": "integrated"
        },
        {
            "name": "jfd_file_packer",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/jfd_asset_file_packer",
            "args": [],
            "cwd": "${workspaceFolder}/run_tree/res",
            "stopOnEntry": false,
            "terminal": "integrated"
        },
        {
            "name": "preprocessor",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/preprocessor",
            "cwd": "${workspaceFolder}/code",
            "stopOnEntry": false,
            "terminal": "integrated",
            "stdio": [
                null,
                "code/meta/GENERATED_program_types.h",
                null
            ]
        },
        {
            "name": "metaprogram",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/metaprogram",
            "cwd": "${workspaceFolder}/code",
            "stopOnEntry": false,
            "terminal": "integrated",
        },
        {
            "name": "new_metaprogram",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/new_metaprogram",
            "cwd": "${workspaceFolder}/code",
            "stopOnEntry": false,
            "terminal": "integrated",
        },
        {
            "name": "slang_reflector",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/slang_reflector",
            "cwd": "${workspaceFolder}/code",
            "args": ["--shader_input_path=../code/shaders", "--shader_output_dir=../run_tree/res/shader_binaries/", "--metagen_c_header_output_dir=meta/"],
            "stopOnEntry": false,
            "terminal": "integrated",
        },
        {
            "name": "sandbox_arg_parser",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/sandbox_arg_parser",
            "cwd": "${workspaceFolder}/code",
            "stopOnEntry": false,
            "terminal": "integrated",
        },
        {
            "name": "sandbox_hash_table",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/sandbox_hash_table",
            "cwd": "${workspaceFolder}/code",
            "stopOnEntry": false,
            "terminal": "integrated",
        },
        {
            "name": "sandbox_memory_arena",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/sandbox_memory_arena",
            "cwd": "${workspaceFolder}/code",
            "stopOnEntry": false,
            "terminal": "integrated",
        },
        {
            "name": "sandbox_networking",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/sandbox_networking",
            "cwd": "${workspaceFolder}/code",
            "stopOnEntry": false,
            "terminal": "integrated",
        },
        {
