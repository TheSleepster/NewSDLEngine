{
    // New Launch.json for xmake
    "version": "0.2.0",
    "initCommands": [
        "settings set target.x86-disassembly-flavor intel"
    ],
    "inputs": [
        {
            "id": "buildConfig",
            "type": "pickString",
            "description": "Build config",
            "options": ["Debug", "Release"],
            "default": "Debug"
        },
        {
            "id": "Sandboxes",
            "type": "pickString",
            "description": "Target to debug",
            "options": [ 
                "sandbox_arg_parser", "sandbox_hash_table", "sandbox_memory_arena",
                "sandbox_networking", "sandbox_new_malloc", "sandbox_new_string_builder",
                "sandbox_new_threadpool", "sandbox_type_info", "sandbox_input",
                "sandbox_dynarray", "sandbox_allocator_benchmark", "sandbox_build_system"
            ]
        },
        {
            "id": "Tests",
            "type": "pickString",
            "description": "Target to debug",
            "options": [ 
                "test_new_malloc", "test_new_metaprogram"
            ]
        },
        {
            "id": "Set Working Directory",
            "type": "pickString",
            "description": "Working directory",
            "options": ["${workspaceFolder}/code", "${workspaceFolder}/run_tree/res"],
            "default": "${workspaceFolder}/code"
        }
    ],

    "configurations": [
        {
            "name": "Debug Game",
            "request": "launch",
            "type": "lldb",
            "windows": {
                "program": "${workspaceFolder}/build/Win32/${input:buildConfig}/game_DEBUG.exe"
            },
            "linux": {
                "program": "${workspaceFolder}/build/Linux/${input:buildConfig}/game_DEBUG"
            },
            "args": ["--host", "7777"],
            "cwd": "${workspaceFolder}/run_tree/res",
            "stopOnEntry": false,
            "terminal": "integrated"
        },
        {
            "name": "jfd_file_packer",
            "type": "lldb",
            "request": "launch",
            "windows": {
                "program": "${workspaceFolder}/build/Win32/${input:buildConfig}/jfd_asset_file_packer.exe"
            },
            "linux": {
                "program": "${workspaceFolder}/build/Linux/${input:buildConfig}/jfd_asset_file_packer"
            },
            "args": [],
            "cwd": "${workspaceFolder}/run_tree/res",
            "stopOnEntry": false,
            "terminal": "integrated"
        },
        {
            "name": "athena_reflection",
            "type": "lldb",
            "request": "launch",
            "windows": {
                "program": "${workspaceFolder}/build/Win32/${input:buildConfig}/athena.exe"
            },
            "linux": {
                "program": "${workspaceFolder}/build/Linux/${input:buildConfig}/athena"
            },

            "cwd": "${workspaceFolder}/code",
            "args": ["--directory=/home/justin/personal/projects/c++stuff/NewSDLEngine/code/", "--output_file=../code/meta/ATHENA_GENERATED_RTTI.h"],
            "stopOnEntry": false,
            "terminal": "integrated"
        },
        {
            "name": "slang_reflector",
            "type": "lldb",
            "request": "launch",
            "windows": {
                "program": "${workspaceFolder}/build/Win32/${input:buildConfig}/slang_reflector.exe"
            },                                             
            "linux": {                                     
                "program": "${workspaceFolder}/build/Linux/${input:buildConfig}/slang_reflector"
            },
            "cwd": "${workspaceFolder}/code",
            "args": ["--shader_input_path=../code/shaders", "--shader_output_dir=../run_tree/res/shader_binaries/", "--metagen_c_header_output_dir=meta/"],
            "stopOnEntry": false,
            "terminal": "integrated"
        },
        {
            "name": "Debug Sandbox",
            "type": "lldb",
            "request": "launch",
            "windows": {
                "program": "${workspaceFolder}/build/Win32/${input:buildConfig}/${input:Sandboxes}.exe"
            },                                             
            "linux": {                                     
                "program": "${workspaceFolder}/build/Linux/${input:buildConfig}/${input:Sandboxes}"
            },
            "cwd": "${input:SandboxCwd}",
            "stopOnEntry": false,
            "terminal": "integrated"
        },
        {
            "name": "Run and Debug Test",
            "type": "lldb",
            "request": "launch",
            "windows": {
                "program": "${workspaceFolder}/build/Win32/${input:buildConfig}/${input:Tests}.exe"
            },                                             
            "linux": {                                     
                "program": "${workspaceFolder}/build/Linux/${input:buildConfig}/${input:Tests}"
            },
            "cwd": "${input:SandboxCwd}",
            "stopOnEntry": false,
            "terminal": "integrated"
        }
    ]
}
