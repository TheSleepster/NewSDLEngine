            "cwd": "${workspaceFolder}/code",
            "stopOnEntry": false,
            "terminal": "integrated",
        },
        {
            "name": "sandbox_new_string_builder",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/sandbox_new_string_builder",
            "cwd": "${workspaceFolder}/code",
            "stopOnEntry": false,
            "terminal": "integrated",
        },
        {
            "name": "sandbox_new_threadpool",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/sandbox_new_threadpool",
            "cwd": "${workspaceFolder}/code",
            "stopOnEntry": false,
            "terminal": "integrated",
